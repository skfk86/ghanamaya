{
  "framework": null,
  "installCommand": "npm install --omit=dev --ignore-scripts",
  "buildCommand": "rm -rf public && mkdir -p public/admin public/delete-account && cp -r www/. public/ && cp admin/index.html public/admin/index.html && cp site/delete-account.html public/delete-account/index.html && mkdir -p public/.well-known && cp site/assetlinks.json public/.well-known/assetlinks.json && cp site/play-icon-512.png public/play-icon-512.png",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-release",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/seller.js": {
      "includeFiles": "firestore.indexes.json"
    }
  },
  "rewrites": [
    {
      "source": "/l/:id",
      "destination": "/api/share?id=:id"
    }
  ]
}